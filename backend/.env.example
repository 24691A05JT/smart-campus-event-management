# Backend Server Environment Variables Example

# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas Connection String from MongoDB Cloud Console
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart-campus-db?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=30d

# Frontend Deployed URL (for production CORS configuration on Render)
# Example: https://smart-campus-events.vercel.app
FRONTEND_URL=http://localhost:3000

# Cloudinary Storage Configuration (Optional)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional Email Notification Configuration (Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="Smart Campus System" <no-reply@smartcampus.edu>

